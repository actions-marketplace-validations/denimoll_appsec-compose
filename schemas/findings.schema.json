{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/denimoll/appsec-compose/schemas/findings.schema.json",
  "title": "appsec-compose findings.json",
  "description": "Consolidated, de-duplicated findings of one appsec-compose run. `schema_version` follows major.minor: the major changes only when a field is removed, renamed or changes meaning; additions bump the minor, so consumers must ignore fields they do not know.",
  "type": "object",
  "required": ["schema_version", "provenance", "policy", "dedup", "baseline",
               "coverage", "severity_counts", "category_counts", "tool_counts",
               "reports_found", "reports_missing", "reports_errored",
               "findings", "suppressed"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "provenance": {
      "type": "object",
      "required": ["appsec_compose", "generated", "target", "offline", "engines", "databases"],
      "properties": {
        "appsec_compose": {"type": "string", "description": "Tool version."},
        "generated": {"type": "string", "description": "UTC, ISO 8601."},
        "target": {"type": "string", "description": "`filesystem`, `docker-archive` or the scanned image ref."},
        "offline": {"type": "boolean"},
        "engines": {"type": "object", "additionalProperties": {"type": "string"},
                    "description": "Engine -> resolved image ref (a digest when pinned)."},
        "databases": {"type": "object", "additionalProperties": {"type": "string"},
                      "description": "Vulnerability database -> date it was built."},
        "scope": {"$ref": "#/$defs/scope"},
        "repo_config": {
          "type": ["object", "null"],
          "description": "1.4: the scanned repository's own config, when one applied: the keys it set and the ones refused (only project policy is honoured from a repo).",
          "properties": {"file": {"type": "string"},
                         "applied": {"type": "array", "items": {"type": "string"}},
                         "dropped": {"type": "array", "items": {"type": "string"}}}
        },
        "checkov_frameworks": {
          "description": "1.3: the Checkov frameworks run — the ones the repository has files for, \"all\", or \"none\" (no IaC, Checkov not started).",
          "anyOf": [{"type": "string", "enum": ["all", "none"]}, {"type": "array", "items": {"type": "string"}}]
        },
        "timings": {
          "type": "object",
          "description": "1.3: where the run's time went. Engines run in parallel, so the scan takes as long as the slowest.",
          "properties": {
            "engines": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0},
                        "description": "Engine -> seconds it ran, slowest first (from Docker's start/finish times)."},
            "scanners_s": {"type": ["integer", "null"], "description": "Wall clock of the parallel scanner phase."},
            "collector_s": {"type": "number", "description": "Time the collector took to merge, gate and write reports."},
            "total_s": {"type": ["integer", "null"], "description": "From run.sh start to the reports being written."}
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "required": ["fail_on", "fail_on_by_category", "fail_on_exploitable", "strict",
                   "breaching", "exploitable_breaching", "exit_code"],
      "properties": {
        "fail_on": {"$ref": "#/$defs/threshold"},
        "fail_on_by_category": {"type": "object", "additionalProperties": {"$ref": "#/$defs/threshold"}},
        "fail_on_exploitable": {"type": "boolean"},
        "strict": {"type": "boolean"},
        "breaching": {"type": "integer", "minimum": 0},
        "exploitable_breaching": {"type": "integer", "minimum": 0},
        "exit_code": {"type": "integer", "enum": [0, 1], "description": "0 = pass, 1 = the policy gate failed."}
      }
    },
    "dedup": {
      "type": "object",
      "required": ["enabled", "raw_findings", "unique_findings", "duplicates_removed"],
      "properties": {
        "enabled": {"type": "boolean"},
        "raw_findings": {"type": "integer", "minimum": 0},
        "unique_findings": {"type": "integer", "minimum": 0},
        "duplicates_removed": {"type": "integer", "minimum": 0}
      }
    },
    "suppressed_count": {"type": "integer", "minimum": 0},
    "expired_suppressions": {
      "type": "array",
      "items": {"type": "object", "required": ["selectors", "expires"],
                "properties": {"selectors": {"type": "string"}, "expires": {"type": "string"}}}
    },
    "enrichment": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "mode": {"type": ["string", "null"]},
        "requested": {"type": "integer"},
        "resolved": {"type": "integer"},
        "reprioritized": {"type": "integer"},
        "exploitable": {"type": "integer"},
        "error": {"type": ["string", "null"]}
      }
    },
    "baseline": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "new": {"type": ["integer", "null"]},
        "known": {"type": ["integer", "null"]},
        "fixed": {"type": ["integer", "null"],
                  "description": "Null in diff mode: a baseline entry outside the changed files was not looked for."},
        "legacy_format": {"type": ["boolean", "null"],
                          "description": "True when matched against a v1 (line-number) baseline."}
      }
    },
    "coverage": {
      "type": "object",
      "required": ["manifests", "ecosystems", "sbom_components", "warnings"],
      "properties": {
        "manifests": {"type": "array", "items": {"type": "string"}},
        "ecosystems": {"type": "array", "items": {"type": "string"}},
        "sbom_components": {"type": ["integer", "null"]},
        "warnings": {
          "type": "array",
          "items": {"type": "object", "required": ["kind", "message", "advice"],
                    "properties": {"kind": {"type": "string"}, "message": {"type": "string"},
                                   "advice": {"type": "string"}}}
        }
      }
    },
    "licenses": {
      "type": ["object", "null"],
      "description": "Dependency license policy, when `licenses:` is configured (added in 1.1). Denied and warned packages are SCA findings with rule_id LICENSE:<license>.",
      "properties": {
        "packages": {"type": "integer", "minimum": 0},
        "unlicensed": {"type": "integer", "minimum": 0, "description": "Packages whose manifest records no license, so the policy could not judge them."},
        "unlicensed_ecosystems": {"type": "array", "items": {"type": "string"}},
        "denied": {"type": "integer", "minimum": 0},
        "warned": {"type": "integer", "minimum": 0}
      }
    },
    "severity_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
    "category_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
    "tool_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
    "reports_found": {"type": "array", "items": {"type": "string"}},
    "reports_missing": {"type": "array", "items": {"type": "string"}},
    "reports_errored": {"type": "array", "items": {"type": "string"}},
    "components": {
      "type": "array",
      "description": "1.2: SCA findings grouped by package. A view over `findings`: each finding is still gated, suppressed and baselined on its own.",
      "items": {
        "type": "object",
        "required": ["package", "name", "version", "files", "severity", "counts", "vulnerabilities",
                     "upgrade_to", "fixed_in", "unfixed", "malicious", "exploitable", "findings"],
        "properties": {
          "package": {"type": "string", "description": "name@version, as the engines name it."},
          "name": {"type": "string"},
          "version": {"type": "string"},
          "files": {"type": "array", "items": {"type": "string"}, "description": "Manifests that declare it."},
          "severity": {"$ref": "#/$defs/severity"},
          "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
          "vulnerabilities": {"type": "integer", "minimum": 1},
          "upgrade_to": {"type": ["string", "null"],
                         "description": "Lowest version that fixes every listed vulnerability: per vulnerability the lowest named fix above the installed version, then the highest of those. Plain numeric versions only; null when it cannot be derived."},
          "fixed_in": {"type": "array", "items": {"type": "string"},
                       "description": "Every fix version an engine names, first seen first; no single upgrade target is computed."},
          "unfixed": {"type": "integer", "minimum": 0, "description": "Vulnerabilities with no known fixed version."},
          "malicious": {"type": "boolean"},
          "exploitable": {"type": "boolean"},
          "findings": {"type": "array", "items": {"type": "string"}, "description": "Fingerprints of the findings in this component."}
        }
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "suppressed": {
      "type": "array",
      "items": {"allOf": [{"$ref": "#/$defs/finding"},
                          {"type": "object", "required": ["reason"],
                           "properties": {"reason": {"type": "string"}}}]}
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "description": "Since 1.1. What was scanned. `full`: the whole target. `diff` (run.sh --diff): only the files changed between merge-base(base, HEAD) and the working tree, including uncommitted and untracked ones; findings are reported and gated for those files only.",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["full", "diff"]},
        "base": {"type": "string", "description": "The ref given to --diff."},
        "merge_base": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "head": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "files": {"type": "integer", "minimum": 0, "description": "Changed files scanned."},
        "paths": {"type": "array", "items": {"type": "string"}, "description": "Their repo-relative paths."},
        "commits": {"type": "integer", "minimum": 0, "description": "Commits merge_base..head."},
        "history_scanned": {"type": "boolean", "description": "Whether those commits were searched for secrets."},
        "excluded": {"type": "integer", "minimum": 0, "description": "Changed files left out by `exclude:`."},
        "deleted": {"type": "integer", "minimum": 0, "description": "Changed files deleted, so not scanned."},
        "skipped_engines": {"type": "object", "additionalProperties": {"type": "string"},
                            "description": "Engine -> why it was not run (nothing it reads was changed)."},
        "skipped_reports": {"type": "object", "additionalProperties": {"type": "string"},
                            "description": "Native report -> why it was not produced; not counted as missing."},
        "out_of_scope_dropped": {"type": "integer", "minimum": 0,
                                 "description": "Raw findings outside the changed files, dropped."}
      },
      "if": {"properties": {"mode": {"const": "diff"}}},
      "then": {"required": ["base", "merge_base", "head", "files", "paths", "commits",
                            "history_scanned", "skipped_engines", "skipped_reports",
                            "out_of_scope_dropped"]}
    },
    "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
    "threshold": {"enum": ["critical", "high", "medium", "low", "info", "none"]},
    "finding": {
      "type": "object",
      "required": ["fingerprint", "tool", "tools", "category", "rule_id", "severity",
                   "severity_stated", "message", "file", "line", "aliases"],
      "properties": {
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{40}$",
                        "description": "Stable identity across runs: anchored on the flagged code, not its line number. Usable as an `ignore` selector."},
        "tool": {"type": "string", "description": "Engine whose report represents the merged finding."},
        "tools": {"type": "array", "items": {"type": "string"}, "minItems": 1,
                  "description": "Every engine that reported it."},
        "category": {"enum": ["sast", "sca", "secrets", "iac"]},
        "rule_id": {"type": "string", "description": "A CVE id when one is known, else the engine's rule id."},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "severity": {"$ref": "#/$defs/severity"},
        "severity_stated": {"type": "boolean",
                            "description": "True when an engine stated the severity; false when derived from CVSS or the SARIF level."},
        "scanner_severity": {"type": "string", "description": "The engines' severity before it was raised (malicious package) or replaced (CVE-PaaS reprioritization), if either happened."},
        "malicious": {"type": "boolean", "description": "SCA: the advisory says the package itself is malware (an OpenSSF MAL- id, CWE-506 or a GitHub malware advisory). Always severity critical. Added in 1.1."},
        "message": {"type": "string"},
        "description": {"type": "string"},
        "url": {"type": "string"},
        "file": {"type": "string", "description": "Repo-relative path (an OS path in image mode)."},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "end_line": {"type": ["integer", "null"], "minimum": 1},
        "column": {"type": ["integer", "null"], "minimum": 1},
        "end_column": {"type": ["integer", "null"], "minimum": 1},
        "cwe": {"type": "array", "items": {"type": "string", "pattern": "^CWE-[0-9]+$"}},
        "package": {"type": ["string", "null"], "description": "SCA: name@version."},
        "fixed_version": {"type": "string", "description": "SCA: version(s) that fix it, as the engine reported them; empty when none is known."},
        "priority": {"type": "string"},
        "epss": {"type": ["number", "null"]},
        "kev": {"type": "boolean"},
        "poc": {"type": "boolean"},
        "nuclei": {"type": "boolean"},
        "exploitable": {"type": "boolean"},
        "new": {"type": "boolean", "description": "Present only in baseline mode."},
        "on_changed_line": {"type": ["boolean", "null"],
                            "description": "Since 1.1. Present only in diff mode: true when the finding's span touches a line the change added or modified (every line of a new file); null when there is no line to compare (a dependency, or a secret found only in the branch's commits)."}
      }
    }
  }
}
