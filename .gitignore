# Scan outputs — regenerated every run. Everything, not a list of names: a
# new report file must never end up committed by accident.
reports/*

# Keep the reports/ dir tracked but empty.
!reports/.gitkeep

# Generated by scripts/render-env.py from scan-config.yml.
.env

# Offline preload cache (DBs + rulesets) — populated by ./preload.sh.
cache/

__pycache__/
*.pyc
.pytest_cache/
*.bak

# Benchmark corpora + run reports (benchmark/bench.py). The default cache is
# ~/.cache/appsec-compose-bench; this covers `--cache benchmark/.cache`.
benchmark/.cache/

# Per-engine exclude configs generated by scripts/render-env.py.
excludes/

# Per-run state (.env, excludes/, image tar, registry auth) — run.sh removes it.
.run/

# OS / tooling cruft
.DS_Store
.claude/
.img-empty/
.img-archive/
.docker-auth/
